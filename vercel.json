{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/server.mjs" },
    { "source": "/(.*)", "destination": "/server.mjs" }
  ],
  "functions": {
    "server.mjs": {
      "includeFiles": [
        "data/**",
        "dist/**"
      ]
    }
  }
}
