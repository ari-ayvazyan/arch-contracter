{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/api", "destination": "/server.mjs?path=/api" },
    { "source": "/api/(.*)", "destination": "/server.mjs?path=/api/$1" },
    { "source": "/", "destination": "/server.mjs?path=/" },
    { "source": "/(.*)", "destination": "/server.mjs?path=/$1" }
  ],
  "functions": {
    "server.mjs": {
      "includeFiles": "{data/**,dist/**}"
    }
  }
}
