{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Arch-Contracter Lastenheft",
  "description": "Lokaler Dokumentbaum. IDs bleiben bei Umbenennungen stabil. Die Reihenfolge der Einträge in nodes bestimmt die Reihenfolge unter demselben parentId.",
  "type": "object",
  "required": ["schemaVersion", "document", "nodes", "links"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "document": {
      "type": "object",
      "required": ["title"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "customer": { "type": "string" },
        "version": { "type": "string" },
        "date": { "type": "string", "description": "Dokumentdatum im Format YYYY-MM-DD." }
      }
    },
    "nodes": { "type": "array", "minItems": 1, "maxItems": 2000, "items": { "$ref": "#/$defs/node" } },
    "links": { "type": "array", "items": { "$ref": "#/$defs/link" } }
  },
  "$defs": {
    "node": {
      "type": "object",
      "required": ["id", "parentId", "type", "title", "description", "criteria", "exclusions", "notes", "effort", "contract", "questions"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z0-9_-]+$" },
        "parentId": { "type": ["string", "null"], "description": "ID des übergeordneten Elements; nur die Wurzel hat null." },
        "type": { "enum": ["document", "group", "package", "requirement"] },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "description": "Kundentext als Klartext. Zeilenumbrüche bleiben im PDF erhalten." },
        "criteria": { "type": "array", "items": { "type": "string" } },
        "exclusions": { "type": "string" },
        "notes": { "type": "string", "description": "Intern; wird niemals ins Kunden-PDF aufgenommen." },
        "effort": { "enum": [null, 1, 2, 3, 4], "description": "Optionale interne Aufwandsskala." },
        "contract": { "type": "string", "description": "Eigener Vertragsumfang oder leer zum Erben. Ohne Vorgabe: Hauptvertrag. Ein neuer Name isoliert den Teilbaum; explizite Vorgaben tieferer Elemente bleiben erhalten." },
        "questions": { "type": "array", "items": { "$ref": "#/$defs/question" } }
      }
    },
    "question": {
      "type": "object",
      "required": ["id", "text", "answer", "status"],
      "properties": {
        "id": { "type": "string" },
        "text": { "type": "string", "minLength": 1 },
        "answer": { "type": "string" },
        "status": { "enum": ["open", "resolved"] },
        "visibility": { "enum": ["customer", "internal"], "deprecated": true, "description": "Nur für bestehende Daten. Neue Fragen benötigen dieses Feld nicht. Früher intern markierte Fragen bleiben vom PDF ausgeschlossen." }
      }
    },
    "link": {
      "type": "object",
      "required": ["id", "source", "target", "type"],
      "properties": {
        "id": { "type": "string" },
        "source": { "type": "string" },
        "target": { "type": "string" },
        "type": { "enum": ["requires", "reference"] }
      }
    }
  }
}
